{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "package:clean": "rm -rf .env .operator_session* *.keypair.json *.signer.json *.db *.db-wal *.db-shm *.wal node_modules dist coverage",
    "package:release": "rm -f release.zip && zip -r -q release.zip . -x '.git*' '.env*' '*operator_session*' '*.keypair.json' '*.signer.json' '*.db*' '*.wal' 'node_modules/*' 'dist/*' 'coverage/*' 'target/*' '*.log'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run tests/accountingAndReconciliation.test.ts tests/authAndSecurity.test.ts tests/riskEngine.test.ts tests/solanaTransactionBuilder.test.ts tests/challenger_m1_protocol_correctness.test.ts tests/challenger_phase3_verification.test.ts tests/plugAndPlayZeroConfig.test.ts tests/e2e/",
    "signer:import": "tsx scripts/import_signer.ts",
    "test:devnet": "tsx scripts/test_devnet_execution.ts",
    "env:show": "cat .env",
    "postinstall": "node scripts/patch-anchor.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@pump-fun/pump-sdk": "1.37.0",
    "@pump-fun/pump-swap-sdk": "1.20.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "bn.js": "^5.2.5",
    "bs58": "^5.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bn.js": "^5.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "bs58": "^5.0.0",
    "qs": "^6.16.0",
    "lru-cache": "^5.1.1"
  }
}
