ALLOWED_CLUSTER="devnet"  # only devnet is supported in this repo; the cluster guard checks the RPC genesis hash before every buy and sell
ALLOWED_ORIGINS=
ALLOW_LIVE_REAL_MONEY_TRADING="false"
ALLOW_PUBLIC_BIND="false"
APEX_DB_PATH=
APEX_READ_ONLY=  # true = watch and paper trade only, no signing key allowed
AUTO_MANAGE_RECOVERED=
AUTO_SNIPE_ENABLED="false"
BIND_HOST=
CAPITAL_TIER=
CONFLUENCE_MIN_SCORE=  # 0 to 100, default 70
DEFAULT_JITO_TIP_SOL=
DEMO_MODE=
JITO_BLOCK_ENGINE_URL=  # leave empty: Jito is disabled and mainnet block engines are refused
JITO_DEFAULT_TIP_LAMPORTS=180000
JITO_TIP_ACCOUNT=
JITO_TIP_SOL=
MAX_DAILY_LOSS_USD=
MAX_POSITION_SIZE_SOL=
MAX_SLIPPAGE_BPS=
MIN_LIQUIDITY_USD=  # devnet curves are tiny: lower this for a devnet run
OPERATOR_AUTH_TOKEN=""  # minimum 16 characters — generate with: openssl rand -hex 32
OPERATOR_PRIVATE_KEY=
PAPER_BANKROLL_SOL=
PRIORITY_FEE_MICROLAMPORTS=
SIGNER_KEYPAIR_PATH=
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_WS_URL=  # not read by the server; kept for a test (see docs/ENV.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWITTER_BEARER_TOKEN=
