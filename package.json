{
  "name": "apex-quant-hft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "package:clean": "rm -rf .env .operator_session* *.keypair.json *.signer.json *.db *.db-wal *.db-shm *.wal node_modules dist coverage",
    "package:release": "tsx scripts/package_release.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:facades": "tsx scripts/find_facade_tests.ts --baseline tests/facade-baseline.json",
    "test:long": "vitest run -c vitest.long.config.ts",
    "signer:import": "tsx scripts/import_signer.ts",
    "smoke": "tsx scripts/smoke.ts",
    "localnet:e2e": "tsx scripts/localnet/e2e.ts",
    "test:devnet": "tsx scripts/test_devnet_execution.ts",
    "devnet:e2e": "node --require ./scripts/devnet_guard.cjs --import tsx scripts/devnet_e2e.ts",
    "postinstall": "node scripts/patch-anchor.cjs",
    "localnet:auto": "tsx scripts/localnet/auto_run.ts",
    "localnet:seed": "tsx scripts/localnet/seed_proof.ts",
    "localnet:seed-audit": "tsx scripts/localnet/seed_audit_proof.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@pump-fun/pump-sdk": "1.37.0",
    "@pump-fun/pump-swap-sdk": "1.20.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "bn.js": "^5.2.5",
    "bs58": "^5.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bn.js": "^5.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "litesvm": "1.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "bs58": "^5.0.0",
    "qs": "^6.16.0",
    "lru-cache": "^5.1.1"
  }
}
