# ==============================================================================
# APEX QUANT HFT - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment & Server Configuration
NODE_ENV="production"
PORT=3000
BIND_HOST="0.0.0.0"
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
GEMINI_API_KEY=""

# Operator Cryptographic Authentication (B04)
# Pre-shared operator token required to arm live trading and mutate state (minimum 16 characters).
# If left empty, an ephemeral 256-bit token is generated on startup and printed to the stdout banner.
OPERATOR_AUTH_TOKEN=""
OPERATOR_SESSION_SECRET=""

# Mandatory Live Trading Safety Policy Gate (B05)
# Set strictly to "true" to allow arming live trading with real SOL on-chain.
# Defaults safely to "false" to prevent unintentional live execution.
ALLOW_LIVE_REAL_MONEY_TRADING="false"

# Solana Hot Wallet Signer
# Base58 encoded secret key or byte array string (or set SIGNER_KEYPAIR_PATH)
OPERATOR_PRIVATE_KEY=""
SOLANA_PRIVATE_KEY=""
SIGNER_KEYPAIR_PATH=""

# Solana Direct RPC & Market Data Stream
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
SOLANA_WS_URL="wss://api.mainnet-beta.solana.com"
SOLANA_WS_RPC_URL="wss://api.mainnet-beta.solana.com"

# Jito Block Engine & MEV Tip Configuration
JITO_BLOCK_ENGINE_URL="https://mainnet.block-engine.jito.wtf"
JITO_DEFAULT_TIP_LAMPORTS=180000
JITO_TIP_ACCOUNT="96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5"
JITO_TIP_SOL="0.002"
DEFAULT_JITO_TIP_SOL="0.002"

# Execution Fees & Slippage Parameters
PRIORITY_FEE_MICROLAMPORTS="25000"
MAX_SLIPPAGE_BPS="800"

# Capital Tier & Risk Management
CAPITAL_TIER="MICRO_10"
MAX_DAILY_LOSS_USD="2.50"
MAX_POSITION_SIZE_SOL="0.02"

# Synthetic Isolation & Demo Overrides (MUST be false or unset in production)
DEMO_MODE="false"
ENABLE_SYNTHETIC_SOCIAL="false"

# Centralized Exchange Gateways (Optional for Cross-Exchange Latency Arb)
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
COINBASE_API_KEY=""
COINBASE_API_SECRET=""

# Telegram Social Alpha Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# X / Twitter API v2 Bearer Token (Optional)
TWITTER_BEARER_TOKEN=""
